{
  "name": "mcp-server-db",
  "version": "0.1.0",
  "description": "MCP server exposing Postgres, Redis, Elasticsearch, MySQL, MongoDB, and LDAP as tools, with lazy connection management, retry, circuit breaking, per-connection read-only mode, and optional database drivers.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "postgres",
    "redis",
    "elasticsearch",
    "mysql",
    "mongodb",
    "ldap",
    "database",
    "db"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-db": "dist/index.js"
  },
  "files": [
    "dist",
    "config/databases.config.example.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "cockatiel": "^4.0.0",
    "fastmcp": "^4.4.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@elastic/elasticsearch": "^9.4.2",
    "es7-client": "npm:@elastic/elasticsearch@^7.17.14",
    "ioredis": "^5.11.1",
    "ldapts": "8.2.0",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
